{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "predictionguard": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Prediction Guard",
      "options": {
        "baseURL": "https://pg.yourcompany.com/v1",
        "apiKey": "{env:PREDICTIONGUARD_TOKEN}"
      },
      "models": {
        "gemma-3-27b-it": { "name": "Gemma 3 27B (PG)" },
        "gpt-oss-120b": { "name": "GPT-OSS 120B (PG)" },
        "Qwen3-Coder-30B-A3B-Instruct": { "name": "Qwen3 Coder 30B (PG)" },
        "OpenAI/gpt-5.4": { "name": "GPT-5.4 (PG)" }
      }
    }
  }
}
